<?xml version="1.0" encoding="utf-8"?>
<!-- Day skin (SAIC SKIN_THEME_CONFIG = 1).  values-night/colors.xml holds the night skin.
     The now-playing panel is lit by the album, so its colours (panel_*) are the
     same in both skins. -->
<resources>
    <!-- Library side -->
    <color name="bg">#FFEEF1F4</color>
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_hi">#FFDDE3E9</color>
    <color name="ink">#FF161B21</color>
    <color name="ink_2">#FF4E5964</color>
    <color name="ink_3">#FF7D8792</color>
    <color name="line">#FFD5DBE1</color>
    <color name="placeholder">#FFDCE2E8</color>
    <!-- Dashboard amber: accent fills buttons and indicators (dark text on it);
         accent_ink is the darker amber used for text and icons on the page. -->
    <color name="accent">#FFEE9A1E</color>
    <color name="on_accent">#FF1C1305</color>
    <color name="accent_soft">#33EE9A1E</color>
    <color name="accent_ink">#FF9A5800</color>

    <!-- Now-playing panel (always dark) -->
    <color name="panel_bg">#FF101318</color>
    <color name="panel_ink">#FFFFFFFF</color>
    <color name="panel_ink_2">#D9FFFFFF</color>
    <color name="panel_ink_3">#99FFFFFF</color>
    <color name="panel_track">#40FFFFFF</color>
    <color name="panel_accent">#FFF5A524</color>
    <color name="panel_on_accent">#FF1C1305</color>
    <color name="panel_placeholder">#FF1C2128</color>
</resources>
