<?xml version="1.0" encoding="utf-8"?>
<!-- Loading spinner, or a message with one action.  Inflated by LoadStateView. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent"/>

    <LinearLayout
        android:id="@+id/message"
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="@dimen/space_m"
            android:src="@drawable/ic_alert"
            android:contentDescription="@null"
            app:tint="@color/ink_3"/>

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/Text.Heading"/>

        <TextView
            android:id="@+id/body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:textAppearance="@style/Text.Secondary"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action"
            style="@style/PillButton.Quiet"
            android:layout_width="wrap_content"
            android:layout_marginTop="@dimen/space_l"/>

    </LinearLayout>
</merge>
