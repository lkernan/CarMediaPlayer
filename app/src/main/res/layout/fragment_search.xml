<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_xs">

        <EditText
            android:id="@+id/query"
            style="@style/Field"
            android:layout_height="88dp"
            android:paddingStart="84dp"
            android:paddingEnd="96dp"
            android:hint="@string/search_hint"
            android:inputType="text"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:textSize="27sp"/>

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="32dp"
            android:src="@drawable/ic_search"
            android:contentDescription="@null"
            app:tint="@color/ink_3"/>

        <ImageButton
            android:id="@+id/clear"
            style="@style/IconButton"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@string/clear"
            android:src="@drawable/ic_close"
            android:visibility="gone"/>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:paddingBottom="@dimen/space_l"
            android:clipToPadding="false"
            android:scrollbars="none"/>

        <com.saicmotor.media.ui.common.LoadStateView
            android:id="@+id/state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>
    </FrameLayout>
</LinearLayout>
