<?xml version="1.0" encoding="utf-8"?>
<!-- The album fills the panel; the song and its controls sit over the lower
     part on a shade taken from the cover. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panel_bg">

    <ImageView
        android:id="@+id/cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"/>

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Nothing loaded -->
    <LinearLayout
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom|start"
        android:padding="@dimen/panel_padding"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nothing_playing"
            android:textAppearance="@style/Text.Display"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/nothing_playing_body"
            android:textAppearance="@style/Text.Secondary"
            android:textColor="@color/panel_ink_2"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/empty_shuffle"
            style="@style/PillButton"
            android:layout_width="wrap_content"
            android:layout_height="96dp"
            android:minHeight="96dp"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginBottom="@dimen/space_xs"
            android:paddingStart="44dp"
            android:paddingEnd="52dp"
            android:text="@string/shuffle_all"
            android:textColor="@color/panel_on_accent"
            android:textSize="28sp"
            app:backgroundTint="@color/panel_accent"
            app:cornerRadius="48dp"
            app:icon="@drawable/ic_shuffle"
            app:iconSize="34dp"
            app:iconTint="@color/panel_on_accent"/>
    </LinearLayout>

    <!-- Song + controls -->
    <LinearLayout
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="@dimen/panel_padding"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:shadowColor="#4D000000"
                android:shadowRadius="10"
                android:textAppearance="@style/Text.Display"/>

            <TextView
                android:id="@+id/artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:shadowColor="#4D000000"
                android:shadowRadius="8"
                android:textAppearance="@style/Text.Body"
                android:textColor="@color/panel_ink_2"/>

            <TextView
                android:id="@+id/album"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:shadowColor="#4D000000"
                android:shadowRadius="8"
                android:textAppearance="@style/Text.Secondary"
                android:textColor="@color/panel_ink_3"/>
        </LinearLayout>

        <SeekBar
            android:id="@+id/seek"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_s"
            android:layout_marginStart="-16dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:progressDrawable="@drawable/seek_progress"
            android:thumb="@drawable/seek_thumb"
            android:splitTrack="false"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/position"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/Text.Caption"
                android:textColor="@color/panel_ink_3"/>

            <TextView
                android:id="@+id/remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Text.Caption"
                android:textColor="@color/panel_ink_3"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:layout_marginStart="-16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/previous"
                style="@style/PanelButton"
                android:padding="20dp"
                android:contentDescription="@string/previous"
                android:src="@drawable/ic_skip_previous"/>

            <Space android:layout_width="@dimen/panel_gap" android:layout_height="1dp"/>

            <ImageButton
                android:id="@+id/play"
                android:layout_width="@dimen/panel_play"
                android:layout_height="@dimen/panel_play"
                android:padding="34dp"
                android:scaleType="fitCenter"
                android:background="@drawable/play_button_background"
                android:contentDescription="@string/play"
                android:src="@drawable/ic_play"
                app:tint="@color/panel_on_accent"/>

            <Space android:layout_width="@dimen/panel_gap" android:layout_height="1dp"/>

            <ImageButton
                android:id="@+id/next"
                style="@style/PanelButton"
                android:padding="20dp"
                android:contentDescription="@string/next"
                android:src="@drawable/ic_skip_next"/>

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
