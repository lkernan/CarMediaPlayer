<?xml version="1.0" encoding="utf-8"?>
<!-- Home's opening row: the one big thing to press. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="@dimen/space_xs"
    android:paddingBottom="@dimen/space_xs">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/primary"
        style="@style/PillButton"
        android:layout_width="wrap_content"
        android:layout_height="96dp"
        android:minHeight="96dp"
        android:paddingStart="44dp"
        android:paddingEnd="52dp"
        android:textSize="28sp"
        app:cornerRadius="48dp"
        app:iconSize="34dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/secondary"
        style="@style/PillButton.Quiet"
        android:layout_width="wrap_content"
        android:layout_height="96dp"
        android:minHeight="96dp"
        android:layout_marginStart="@dimen/space_m"
        android:paddingStart="40dp"
        android:paddingEnd="44dp"
        app:cornerRadius="48dp"/>

</LinearLayout>
