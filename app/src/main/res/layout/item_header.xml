<?xml version="1.0" encoding="utf-8"?>
<!-- Top of an album, artist, playlist or genre page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="bottom"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="@dimen/space_xs"
    android:paddingBottom="@dimen/space_l">

    <com.saicmotor.media.ui.common.SquareImageView
        android:id="@+id/cover"
        android:layout_width="@dimen/detail_cover"
        android:layout_height="@dimen/detail_cover"
        android:layout_marginEnd="40dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Cover"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:ellipsize="end"
            android:textAppearance="@style/Text.Title"/>

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textAppearance="@style/Text.Body"
            android:textColor="@color/ink_2"/>

        <TextView
            android:id="@+id/meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textAppearance="@style/Text.Secondary"
            android:textColor="@color/ink_3"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primary"
                style="@style/PillButton"
                android:layout_width="wrap_content"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/secondary"
                style="@style/PillButton.Quiet"
                android:layout_width="wrap_content"
                android:layout_marginStart="@dimen/space_m"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tertiary"
                style="@style/PillButton.Quiet"
                android:layout_width="wrap_content"
                android:layout_marginStart="@dimen/space_m"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
