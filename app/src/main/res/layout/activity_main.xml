<?xml version="1.0" encoding="utf-8"?>
<!-- Split screen: now playing on the left (a square as tall as the screen),
     the library on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg">

    <com.saicmotor.media.ui.common.SquarePanelLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/now_playing"
            android:name="com.saicmotor.media.ui.nowplaying.NowPlayingFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.saicmotor.media.ui.common.SquarePanelLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Top bar: back, destinations, Up next, Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="@dimen/space_m">

            <ImageButton
                android:id="@+id/back"
                style="@style/IconButton"
                android:layout_marginEnd="@dimen/space_xs"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back"
                android:visibility="gone"
                app:tint="@color/ink"/>

            <TextView
                android:id="@+id/tab_home"
                style="@style/TopTab"
                android:text="@string/tab_home"/>

            <TextView
                android:id="@+id/tab_search"
                style="@style/TopTab"
                android:text="@string/tab_search"/>

            <TextView
                android:id="@+id/tab_library"
                style="@style/TopTab"
                android:text="@string/tab_library"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/tab_queue"
                style="@style/IconButton"
                android:layout_height="match_parent"
                android:paddingTop="34dp"
                android:paddingBottom="34dp"
                android:background="@drawable/tab_background"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/up_next"
                android:src="@drawable/ic_queue"
                app:tint="@color/tab_text"/>

            <ImageButton
                android:id="@+id/tab_settings"
                style="@style/IconButton"
                android:layout_height="match_parent"
                android:paddingTop="34dp"
                android:paddingBottom="34dp"
                android:layout_marginStart="@dimen/space_xs"
                android:background="@drawable/tab_background"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_settings"
                app:tint="@color/tab_text"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
