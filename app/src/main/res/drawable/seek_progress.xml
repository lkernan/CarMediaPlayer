<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical" android:height="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/panel_track"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical" android:height="6dp">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/panel_ink"/>
                <corners android:radius="3dp"/>
            </shape>
        </clip>
    </item>
</layer-list>
